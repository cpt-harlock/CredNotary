#!/bin/busybox sh
# /init of the lab initramfs: mounts the filesystems eBPF needs, mounts the
# host repository over 9p on /mnt/host and runs the command given with
# "run=<script>" on the kernel command line (then powers the VM off).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mkdir -p /proc /sys /dev /tmp /run /mnt/host
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
chmod 1777 /tmp
mount -t securityfs securityfs /sys/kernel/security
mount -t bpf bpf /sys/fs/bpf
mount -t debugfs debugfs /sys/kernel/debug
mount -t tracefs tracefs /sys/kernel/tracing
mount -t cgroup2 cgroup2 /sys/fs/cgroup
mount -t 9p -o trans=virtio,version=9p2000.L,msize=512000 host /mnt/host
hostname ebpf-lab
ip link set lo up

echo "[init] kernel $(uname -r), LSM: $(cat /sys/kernel/security/lsm 2>/dev/null)"

RUN=$(sed -n 's/.*run=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$RUN" ]; then
	cd /mnt/host
	sh "$RUN"
	echo "=== RUN EXIT $? ==="
	sync
	poweroff -f
fi
exec setsid cttyhack sh
